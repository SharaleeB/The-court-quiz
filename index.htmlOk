<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#100d1c">
<title>Which Court of Prythian Claims You?</title>
<style>
:root{--bg:#100d1c;--gold:#d8bd87;--muted:#b8afc6;--panel:rgba(29,23,43,.82)}
*{box-sizing:border-box}
body{margin:0;min-height:100vh;background:radial-gradient(ellipse at 50% 5%,#302343 0%,#171224 44%,#0b0912 100%);color:#f8f1e8;font-family:Georgia,"Times New Roman",serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.45;background-image:radial-gradient(1px 1px at 12% 20%,#fff,transparent),radial-gradient(2px 2px at 76% 12%,#e7d8ff,transparent),radial-gradient(1px 1px at 42% 60%,#fff,transparent),radial-gradient(1px 1px at 87% 73%,#fff,transparent),radial-gradient(2px 2px at 22% 83%,#dfc6ff,transparent),radial-gradient(1px 1px at 62% 38%,#fff,transparent);background-size:280px 260px}
button{font:inherit;cursor:pointer}
.shell{width:min(760px,100%);min-height:100vh;margin:auto;padding:34px 22px 45px;display:flex;flex-direction:column;position:relative}
.top{text-align:center;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:var(--gold)}
main{flex:1;display:flex;align-items:center;justify-content:center}
.screen{width:100%;text-align:center;animation:appear .65s ease both}
@keyframes appear{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
@keyframes glow{0%,100%{box-shadow:0 0 12px #c4a4ff12}50%{box-shadow:0 0 28px #c4a4ff35}}
.moon{font-size:54px;color:var(--gold);margin:22px 0 12px;text-shadow:0 0 35px #c6a6ff66}
h1{font-size:clamp(36px,8vw,62px);font-weight:normal;line-height:1.08;margin:16px auto 20px;max-width:650px}
h2{font-size:clamp(27px,6vw,39px);font-weight:normal;line-height:1.2;margin:18px 0}
p{line-height:1.8;color:#d1c7d9;font-size:16px}
.intro{max-width:520px;margin:0 auto 28px}
.eyebrow{color:var(--gold);font-size:11px;letter-spacing:3px;text-transform:uppercase}
.primary{background:linear-gradient(135deg,#e3ce9e,#b99a66);border:1px solid #f3dfb0;color:#21182b;padding:15px 28px;letter-spacing:2px;text-transform:uppercase;font-size:12px;transition:.25s}
.primary:hover{filter:brightness(1.12);transform:translateY(-2px)}
.small{background:transparent;color:var(--muted);border:1px solid #ffffff25;padding:12px 20px;font-size:12px;letter-spacing:1px}
.rule{height:1px;width:100px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:22px auto}
.progress-wrap{max-width:560px;margin:0 auto 30px;text-align:left}
.progress-label{display:flex;justify-content:space-between;color:var(--muted);font-size:11px;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px}
.track{height:2px;background:#ffffff19}
.fill{height:100%;width:0;background:var(--gold);transition:width .4s}
.question{font-size:clamp(27px,6vw,39px);margin:0 auto 28px;max-width:580px}
.answers{display:grid;grid-template-columns:1fr;gap:10px;max-width:560px;margin:auto}
.answer{display:flex;align-items:center;text-align:left;gap:15px;width:100%;padding:16px 18px;background:var(--panel);border:1px solid #c7b5db28;color:#f4edf8;line-height:1.5;font-size:15px;transition:background .2s,border .2s,transform .2s;animation:appear .4s ease both}
.answer:hover,.answer:focus-visible{border-color:var(--gold);background:#44334f;transform:translateX(3px);outline:none}
.gem{flex:0 0 9px;width:9px;height:9px;border:1px solid var(--gold);transform:rotate(45deg)}
.answer:active{background:#685176}
.note{font-size:12px;color:#9e92ad;margin-top:22px}
.result-symbol{font-size:48px;margin:16px}
.result-name{font-size:clamp(43px,10vw,76px);margin:12px 0;color:var(--gold)}
.result-tagline{font-size:21px;font-style:italic;color:#e2d3ef}
.result-copy{max-width:530px;margin:22px auto}
.magic{color:var(--gold);font-size:12px;letter-spacing:2px;text-transform:uppercase;margin-top:24px}
.result-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:28px}
footer{text-align:center;color:#82768f;font-size:10px;letter-spacing:2px;padding-top:24px}
.hidden{display:none!important}
@media(min-width:600px){.answers{grid-template-columns:1fr 1fr}.answer{min-height:84px}.shell{padding-top:40px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<div class="shell">
<header class="top">✧ A journey through Prythian ✧</header>
<main>
<section id="intro" class="screen">
<div class="moon">☾</div>
<div class="eyebrow">Seven courts. Seven kinds of magic.</div>
<h1>Which Court of Prythian Claims You?</h1>
<div class="rule"></div>
<p class="intro">Beyond the Wall, beyond the mortal lands, seven courts await. Each holds its own magic, its own secrets and its own kind of power.</p>
<p class="intro">Answer instinctively. Choose what feels like you, not what sounds most heroic. Your choices will reveal where your magic belongs.</p>
<p class="intro"><em>The question is not which court you admire most. It is which court would recognise you as one of its own.</em></p>
<button class="primary" id="start">Enter Prythian</button>
<p class="note">15 questions · 7 possible courts · Your fate awaits</p>
</section>

<section id="quiz" class="screen hidden">
<div class="progress-wrap">
<div class="progress-label"><span id="step">Question 1 of 15</span><span id="percent">7%</span></div>
<div class="track"><div class="fill" id="fill"></div></div>
</div>
<div class="eyebrow">Trust your instincts</div>
<h2 class="question" id="question"></h2>
<div class="answers" id="answers"></div>
<p class="note">Choose the answer that feels most like you.</p>
</section>

<section id="result" class="screen hidden">
<div class="eyebrow">The magic has spoken</div>
<div class="result-symbol" id="symbol">✧</div>
<div class="result-name" id="court"></div>
<div class="rule"></div>
<div class="result-tagline" id="tagline"></div>
<p class="result-copy" id="description"></p>
<div class="magic" id="magic"></div>
<p class="result-copy" id="closing"></p>
<div class="result-actions">
<button class="primary" id="share">Share my court</button>
<button class="small" id="restart">Begin again</button>
</div>
<p class="note">A little magic, a little mystery, entirely for fun.</p>
</section>
</main>
<footer>THE SEVEN COURTS · YOUR STORY IS YOURS TO WRITE</footer>
</div>

<script>
const courts = {
Night:{symbol:"☾",color:"#c5a5f0",tag:"The stars remember you.",description:"Fiercely independent, perceptive and loyal beyond measure. You understand that strength doesn't always announce itself; sometimes it watches, waits and protects from the shadows. You value freedom, chosen family and the right to decide your own destiny.",magic:"Your magic: Shadows, starlight and the unseen.",closing:"Your power lies in knowing who deserves to stand beside you — and what you are willing to protect."},
Dawn:{symbol:"☼",color:"#f0bd9a",tag:"You are the promise of a new beginning.",description:"Hopeful, compassionate and quietly resilient, you see possibility where others see an ending. You believe that even broken things can become beautiful, and that kindness can be a kind of courage.",magic:"Your magic: Sunrise, restoration and renewal.",closing:"Even after the longest night, you believe something beautiful can still begin."},
Day:{symbol:"✧",color:"#e6d28b",tag:"Knowledge is its own kind of power.",description:"Curious, analytical and perceptive, you seek truth and find wonder in understanding. You value meaningful conversation, sharp minds and the courage to question what others take for granted.",magic:"Your magic: Light, knowledge and discovery.",closing:"You do not fear difficult questions. You fear never finding the answers."},
Summer:{symbol:"❋",color:"#77d8db",tag:"You were never meant to live in a cage.",description:"Bold, warm and full of life, you believe the world is meant to be experienced. You value honesty, adventure, connection and the freedom to be unapologetically yourself.",magic:"Your magic: Ocean tides, sunlight and storms.",closing:"You make the world brighter simply by refusing to let it make you smaller."},
Winter:{symbol:"❄",color:"#b9d9ef",tag:"There is strength in stillness.",description:"Composed, disciplined and principled, you know that trust is earned. You protect your peace, hold fast to your values and remain steady when life tests you.",magic:"Your magic: Ice, frost and endurance.",closing:"You have learned that a quiet heart can be stronger than the fiercest storm."},
Spring:{symbol:"❀",color:"#b9d99e",tag:"Growth is a form of courage.",description:"Warm-hearted and resilient, you appreciate beauty and believe in healing, tenderness and transformation. You understand that growing into yourself can take time, patience and bravery.",magic:"Your magic: Blossoms, nature and rebirth.",closing:"You are not defined by what has happened to you, but by what you choose to grow from it."},
Autumn:{symbol:"♨",color:"#e7a16d",tag:"You were forged to rise.",description:"Intense, ambitious and determined, you understand that power is complicated and transformation can demand difficult choices. You face challenges head-on and refuse to let circumstances write your ending.",magic:"Your magic: Fire, embers and transformation.",closing:"You do not wait for the world to give you permission to become who you are meant to be."}
};

// Each question contains seven answers. The court attached to an answer
// stays the same even when the displayed answer order is shuffled.
const questions = [
["At a gathering in a magical court, where are you most likely to be found?",[
["Night","On a quiet balcony, watching the stars and observing everything."],["Dawn","On a sunlit terrace, talking about possibilities and new beginnings."],["Day","In a grand library, surrounded by ancient books and curious minds."],["Summer","In the lively heart of the gathering, laughing beside the sea."],["Winter","In a peaceful snow-covered garden, enjoying the silence."],["Spring","Wandering through a beautiful garden filled with flowers."],["Autumn","In a candlelit hall, intrigued by the secrets and politics."]]],
["When life becomes difficult, what strength do you rely on most?",[
["Night","I adapt, notice what others miss and find a way through."],["Dawn","I believe things can improve, even when the path is unclear."],["Day","I gather information and think my way through the problem."],["Summer","I keep my spirit up and bring people together."],["Winter","I stay disciplined and composed under pressure."],["Spring","I care for the people around me and help them recover."],["Autumn","I endure, grow stronger and refuse to surrender."]]],
["Someone you trust betrays you. What is your instinct?",[
["Night","Protect my inner circle and quietly work out my next move."],["Dawn","Seek understanding, while leaving room for healing."],["Day","Examine the facts and decide what is fair."],["Summer","Confront it honestly and refuse to be defined by it."],["Winter","Set firm boundaries and protect my peace."],["Spring","Give myself time to process and heal."],["Autumn","Learn the lesson and never hand them that power again."]]],
["If you could wield one kind of magic, what would call to you?",[
["Night","Moving unseen and commanding shadows beneath a field of stars."],["Dawn","Healing, renewal and the first light after darkness."],["Day","Uncovering hidden truths and mastering ancient knowledge."],["Summer","Controlling ocean tides, sunlight and powerful storms."],["Winter","Summoning ice and possessing extraordinary endurance."],["Spring","Helping nature bloom and bringing life back to the earth."],["Autumn","Wielding fire and transforming what no longer serves me."]]],
["What matters most to you in the people closest to you?",[
["Night","Loyalty that survives even the darkest moments."],["Dawn","Kindness, hope and a desire to grow together."],["Day","Intellectual connection and mutual respect."],["Summer","Honesty, laughter, adventure and freedom."],["Winter","Reliability, discretion and consistency."],["Spring","Tenderness, affection and emotional understanding."],["Autumn","Strength, ambition and someone who challenges me."]]],
["You can disappear for a week. Where do you go?",[
["Night","A secluded mountain retreat beneath a spectacular night sky."],["Dawn","A peaceful sanctuary where I can watch the sunrise."],["Day","A cultured city full of museums, books and discoveries."],["Summer","A tropical coastline filled with music and adventure."],["Winter","A remote cabin surrounded by pristine snow."],["Spring","A cottage among wildflowers and ancient woodland."],["Autumn","A dramatic estate overlooking a copper-coloured forest."]]],
["What motivates you when a challenge seems impossible?",[
["Night","Knowing there are people counting on me."],["Dawn","The possibility of creating something better."],["Day","The need to solve the problem and understand it."],["Summer","The thrill of proving that it can be done."],["Winter","My refusal to give up on what matters."],["Spring","The chance to rebuild something worth protecting."],["Autumn","The determination to prove my own strength."]]],
["You discover that a rule is deeply unfair. What do you do?",[
["Night","Find a clever way around it without revealing my plans."],["Dawn","Challenge it and work towards a better way."],["Day","Research the issue and build a compelling argument."],["Summer","Question it openly and rally others to speak up."],["Winter","Stand by my principles, even if I stand alone."],["Spring","Work towards change while minimising unnecessary harm."],["Autumn","Break it if it stands in the way of what must be done."]]],
["In a group facing uncertainty, which role comes naturally?",[
["Night","The strategist who sees the hidden possibilities."],["Dawn","The mediator who reminds everyone of a way forward."],["Day","The adviser who brings insight and clear reasoning."],["Summer","The energetic leader who gets everyone moving."],["Winter","The steady presence people can depend on."],["Spring","The person making sure nobody is left behind."],["Autumn","The decisive one willing to make difficult choices."]]],
["Which possibility unsettles you the most?",[
["Night","Being unable to protect the people I love."],["Dawn","Losing the hope that things can get better."],["Day","Living without ever discovering the truth."],["Summer","Being trapped somewhere I cannot express myself."],["Winter","Losing control of myself in a crucial moment."],["Spring","Finding it impossible to love or trust again."],["Autumn","Having no say in the direction of my own future."]]],
["What does a truly meaningful relationship feel like?",[
["Night","An unwavering bond and a chosen family that stands together."],["Dawn","A gentle connection where we grow into better versions of ourselves."],["Day","A meeting of minds where conversation never grows dull."],["Summer","A passionate, playful partnership that leaves room for freedom."],["Winter","A quiet, dependable love shown through actions."],["Spring","A tender connection where vulnerability feels safe."],["Autumn","An intense bond between two equally strong people."]]],
["What do people tend to misunderstand about you?",[
["Night","My independence can hide how deeply I care."],["Dawn","My optimism doesn't mean I've never suffered."],["Day","My analytical nature doesn't mean I lack emotion."],["Summer","My confidence can hide moments of uncertainty."],["Winter","My reserve can be mistaken for coldness."],["Spring","My gentleness can be mistaken for weakness."],["Autumn","My ambition can be mistaken for a lack of heart."]]],
["What kind of legacy would make you proud?",[
["Night","Knowing I protected people and gave them the freedom to be themselves."],["Dawn","Helping others find hope when they needed it most."],["Day","Leaving behind knowledge that changed how people understand the world."],["Summer","Inspiring people to live boldly and embrace joy."],["Winter","Being remembered for courage and unwavering principles."],["Spring","Helping people heal, grow and begin again."],["Autumn","Overcoming the odds and shaping my own destiny."]]],
["A dangerous situation unfolds. What is your first instinct?",[
["Night","Gather information and find the most strategic position."],["Dawn","Help everyone find a safe way forward."],["Day","Work out what the threat is and how it operates."],["Summer","Act quickly and bring people together."],["Winter","Assess the danger and hold my ground."],["Spring","Make sure the most vulnerable people are safe."],["Autumn","Confront the threat directly and decisively."]]],
["When you imagine a life that feels truly yours, what matters most?",[
["Night","Freedom, meaningful bonds and knowing my people are safe."],["Dawn","Peace, purpose and helping others see possibilities."],["Day","Understanding the world and always having more to discover."],["Summer","Living freely, finding joy and collecting unforgettable experiences."],["Winter","Knowing I stayed true to my principles."],["Spring","Love, growth and the chance to keep renewing myself."],["Autumn","Having the strength and freedom to choose my own future."]]]
];

let index=0, scores={}, locked=false, lastResult=null;
const $=id=>document.getElementById(id);
const shuffle=array=>{
 const copy=[...array];
 for(let i=copy.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [copy[i],copy[j]]=[copy[j],copy[i]];
 }
 return copy;
};
function showScreen(name){
 ["intro","quiz","result"].forEach(id=>$(id).classList.toggle("hidden",id!==name));
 window.scrollTo({top:0,behavior:"smooth"});
}
function startQuiz(){
 index=0;scores=Object.fromEntries(Object.keys(courts).map(c=>[c,0]));
 locked=false;showScreen("quiz");renderQuestion();
}
function renderQuestion(){
 locked=false;
 const q=questions[index];
 $("step").textContent=`Question ${index+1} of ${questions.length}`;
 $("percent").textContent=`${Math.round((index+1)/questions.length*100)}%`;
 $("fill").style.width=`${(index+1)/questions.length*100}%`;
 $("question").textContent=q[0];
 const container=$("answers");container.replaceChildren();
 shuffle(q[1]).forEach(([court,label],i)=>{
  const button=document.createElement("button");
  button.className="answer";button.style.animationDelay=`${i*35}ms`;
  const gem=document.createElement("span");gem.className="gem";
  const text=document.createElement("span");text.textContent=label;
  button.append(gem,text);
  button.addEventListener("click",()=>chooseAnswer(court));
  container.append(button);
 });
}
function chooseAnswer(court){
 if(locked)return;locked=true;
 scores[court]++;
 $("answers").querySelectorAll("button").forEach(b=>b.disabled=true);
 const current=$("quiz");current.style.animation="none";current.offsetHeight;
 current.style.animation="appear .35s ease reverse both";
 setTimeout(()=>{
  index++;
  if(index<questions.length){current.style.animation="";renderQuestion();}
  else showResult();
 },300);
}
function showResult(){
 const max=Math.max(...Object.values(scores));
 const winners=Object.keys(scores).filter(c=>scores[c]===max);
 // If tied, use the participant's last answer among the tied courts.
 // If that does not resolve it, use a random tied winner.
 const court=winners.includes(lastResult)?lastResult:winners[Math.floor(Math.random()*winners.length)];
 const result=courts[court];
 $("court").textContent=court+" Court";
 $("symbol").textContent=result.symbol;
 $("symbol").style.color=result.color;
 $("court").style.color=result.color;
 $("tagline").textContent=result.tag;
 $("description").textContent=result.description;
 $("magic").textContent=result.magic;
 $("closing").textContent=result.closing;
 document.title=`${court} Court | Which Court of Prythian Claims You?`;
 showScreen("result");
}
$("start").addEventListener("click",()=>{
 lastResult=null;
 // Track the final answer for tie-breaking.
 const original=chooseAnswer;
 startQuiz();
});
$("restart").addEventListener("click",()=>{
 document.title="Which Court of Prythian Claims You?";
 lastResult=null;startQuiz();
});
$("share").addEventListener("click",async()=>{
 const court=$("court").textContent;
 const text=`My magic belongs to the ${court}! Which Court of Prythian Claims You?`;
 try{
  if(navigator.share) await navigator.share({title:"My Court of Prythian",text,url:location.href});
  else if(navigator.clipboard&&window.isSecureContext){
   await navigator.clipboard.writeText(text+" "+location.href);
   $("share").textContent="Copied to clipboard!";
   setTimeout(()=>$("share").textContent="Share my court",2200);
  }else{
   window.prompt("Copy your result and quiz link:",text+" "+location.href);
  }
 }catch(e){if(e.name!=="AbortError")window.prompt("Copy your result:",text+" "+location.href);}
});
</script>
</body>
</html>
